# RiskNResQ Production Environment Configuration
# Copy this file to .env and populate with your production credentials

# Google Maps Platform - Routes API
# Required for production routing and traffic evaluation
GOOGLE_ROUTES_API_KEY=

# India Meteorological Department (IMD) API
# Optional: if omitted, system automatically falls back to Open-Meteo real weather
IMD_API_KEY=

# Karnataka State Natural Disaster Monitoring Centre (KSNDMC)
KSNDMC_API_KEY=

# Database. PostgreSQL (recommended):  postgresql://user:password@localhost:5432/risknresq
# Or a local SQLite file for a quick demo:  sqlite:///./resilienturban.db
DATABASE_URL=postgresql://user:password@localhost:5432/risknresq

# Super Admin account, created on first start (choose your own; min 8 characters for the password)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
ADMIN_NAME="Super Admin"

# CORS Allowed Origins (comma-separated or * for wildcard)
CORS_ORIGINS=*

# Server Port and Host
HOST=0.0.0.0
PORT=8000

# Sample data for presentations only (a demo volunteer roster and one demo incident). Leave false for real use.
DEMO_DATA=false

# Cloudinary image storage for incident photos. Keep the API secret HERE, on the backend only: never in the mobile app.
# If these three are empty the backend stores photos on its own disk instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Weather monitoring grid (backend polls Open-Meteo; phones only read the cached result)
# south,west,north,east of the area to watch (default: Bengaluru). GRID_SPACING in degrees (~9 km at 0.08).
MONITORING_BOUNDS=12.83,77.45,13.15,77.79
GRID_SPACING=0.08
WEATHER_REFRESH_INTERVAL=900
# rain-rate classes in mm per hour (tunable): below MODERATE is LOW
RAIN_MODERATE_THRESHOLD=2.5
HEAVY_RAIN_THRESHOLD=7.5
RAIN_VERY_HEAVY_THRESHOLD=15
