# RiskNResQ Production Environment Configuration
# Copy this file to .env and populate with your production credentials

# Google Maps Platform - Routes API
# Required for production routing and traffic evaluation
GOOGLE_ROUTES_API_KEY=

# India Meteorological Department (IMD) API
# Optional: if omitted, system automatically falls back to Open-Meteo real weather
IMD_API_KEY=

# Karnataka State Natural Disaster Monitoring Centre (KSNDMC)
KSNDMC_API_KEY=

# Database. PostgreSQL (recommended):  postgresql://user:password@localhost:5432/risknresq
# Or a local SQLite file for a quick demo:  sqlite:///./resilienturban.db
DATABASE_URL=postgresql://user:password@localhost:5432/risknresq

# Super Admin account, created on first start (choose your own; min 8 characters for the password)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
ADMIN_NAME="Super Admin"

# CORS Allowed Origins (comma-separated or * for wildcard)
CORS_ORIGINS=*

# Server Port and Host
HOST=0.0.0.0
PORT=8000

# Sample data for presentations only (a demo volunteer roster and one demo incident). Leave false for real use.
DEMO_DATA=false

# Cloudinary image storage for incident photos. Keep the API secret HERE, on the backend only: never in the mobile app.
# If these three are empty the backend stores photos on its own disk instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Weather monitoring grid (backend polls Open-Meteo; phones only read the cached result)
# south,west,north,east of the area to watch (default: Bengaluru). GRID_SPACING in degrees (~9 km at 0.08).
MONITORING_BOUNDS=12.83,77.45,13.15,77.79
GRID_SPACING=0.08
WEATHER_REFRESH_INTERVAL=900
# rain-rate classes in mm per hour (tunable): below MODERATE is LOW
RAIN_MODERATE_THRESHOLD=2.5
HEAVY_RAIN_THRESHOLD=7.5
RAIN_VERY_HEAVY_THRESHOLD=15

# Public address of the deployed app (used in links), and optional notification channels. Nothing is sent unless configured.
APP_URL=
# Email (password reset and verification codes). Without SMTP the code is only written to the server log (development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMS / WhatsApp through Twilio. TWILIO_FROM is an SMS number, or whatsapp:+14155238886 for the WhatsApp sandbox.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_MAX_RECIPIENTS=200
# Push notifications use Expo's free push service (no key needed). Set PUSH_ENABLED=0 to switch them off.
PUSH_ENABLED=1
# Hardening: per-IP requests per minute (all endpoints / the /auth endpoints), proxy trust, error reporting
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY=0
SENTRY_DSN=

# Flood intelligence. All data sources are free and need no key (Open-Meteo, Microsoft Planetary Computer, OpenStreetMap).
INTEL_ENABLED=1
SATELLITE_REFRESH_INTERVAL=21600
WATER_LEVEL_REFRESH_INTERVAL=21600
# Sentinel-1 VV backscatter below this (dB) is treated as open water; a cell is "abnormal" when its net water gain
# is at least SAT_ABNORMAL_MIN_KM2 and SAT_ABNORMAL_MIN_PCT of the earlier passes. Heuristics, tune with care.
SAR_WATER_THRESHOLD_DB=-16
SAT_ABNORMAL_MIN_KM2=0.5
SAT_ABNORMAL_MIN_PCT=40
SATELLITE_STALE_DAYS=14
# Optional overrides
PLANETARY_COMPUTER_URL=https://planetarycomputer.microsoft.com/api
OVERPASS_URL=https://overpass-api.de/api/interpreter

# RiskN AI (optional). Answers are always built from RiskN ResQ data by the built-in grounded engine; a key only lets an LLM
# reword that grounded answer. AI_PROVIDER: auto (Gemini, then OpenAI), gemini, openai. AI_MODEL overrides the default model.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=auto
AI_MODEL=

# Data sources that need NO key: Open-Meteo (weather, flood/GloFAS, archive/ERA5, elevation/Copernicus DEM),
# Microsoft Planetary Computer (Sentinel-1), NASA GIBS (daily imagery and flood products), OpenStreetMap (Overpass).
PLANETARY_COMPUTER_URL=https://planetarycomputer.microsoft.com/api
# Deployment behind a proxy (Render, Fly, nginx): trust X-Forwarded-For for rate limits and close CORS to CORS_ORIGINS
TRUST_PROXY=
# Optional error reporting
SENTRY_DSN=
