# Public values only: anything here is visible inside the app. Never put passwords, database URLs,
# Cloudinary secrets or the admin password in a mobile environment file.

# Where the backend is. Leave empty to auto-detect your computer's address when running through Expo.
# Use https:// for a deployed backend.
EXPO_PUBLIC_API_URL=

# REQUIRED for any release / EAS build: the https:// address of your deployed backend. Without it a release build has NO server
# address and says so (it never silently talks to localhost). For EAS builds set it with:  eas env:create  (or eas secret:create).
EXPO_PUBLIC_API_URL=https://your-backend.onrender.com
# Only for standalone Android/iOS builds that use Google map tiles (Expo Go and the browser do not need it)
GOOGLE_MAPS_API_KEY=
